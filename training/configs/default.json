{
  "seed": 42,
  "experimental": true,
  "training_language": "en",
  "language_by_origin": {
    "data/raw/pubhealth": "en"
  },
  "candidates": [
    "transformer"
  ],
  "split": {
    "train": 0.7,
    "val": 0.15,
    "test": 0.15,
    "group_column": "url"
  },
  "selection_metric": "macro_f1",
  "acceptance_gate": {
    "min_macro_f1": 0.8,
    "min_per_class_recall": 0.7
  },
  "transformer": {
    "enabled": true,
    "model_name": "FacebookAI/xlm-roberta-base",
    "max_length": 128,
    "batch_size": 4,
    "eval_batch_size": 4,
    "grad_accum_steps": 8,
    "learning_rate": 2e-05,
    "epochs": 3,
    "fp16": true
  },
  "_note": "English PUBHEALTH continuation profile. Downloads the public pretrained base model on first training. The supplied classifier is experimental; use a new version for every run. Packaging does not deploy automatically."
}
